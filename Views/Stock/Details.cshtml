@model TradeSim.Models.ViewModels.StockDetailsViewModel

@{
    Layout = "_TradingLayout";
}
@section Styles {

    <link rel="stylesheet" href="~/css/pages/stock-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/compo/order-drawer.css" asp-append-version="true" />
    
}
<div class="stock-page">

    <!-- Header -->
    <header class="stock-header">

        <a asp-controller="Watchlist"
           asp-action="Index"
           class="back-link">
            ← Watchlist
        </a>

        <div class="header-actions">

            <button class="watchlist-btn">
                ☆ Watchlist
            </button>

            <button id="buyButton" class="buy-btn">
                BUY
            </button>

            <button id="sellButton" class="sell-btn">
                SELL
            </button>

        </div>

    </header>

    <!-- Stock Summary -->
    <section class="stock-summary">

        <div class="summary-company">

            <h1>@Model.CompanyName</h1>

            <div class="summary-meta">

                <span class="exchange-pill">NSE</span>

                <span class="equity-pill">Equity</span>

            </div>

        </div>

        <div class="summary-price">

            <div class="stock-price">
                ₹@Model.LastPrice.ToString("N2")
            </div>

            <div class="stock-change positive">

                +25.40 (0.90%)

                <span class="live-pill">
                    ● LIVE
                </span>

            </div>

        </div>

    </section>

    <!-- Workspace Tabs -->
    <section class="workspace-tabs">

        <button class="tab-btn active">
            Chart
        </button>

        <button class="tab-btn">
            F&O
        </button>

    </section>

    <!-- Workspace -->
    <section class="workspace-content" id="workspaceContent">

        <div class="chart-container">

            <div class="chart-placeholder">
                
                    <div class="tradingview-widget-container">

                        <div id="tradingview_chart"></div>

                    </div>
            </div>

        </div>

        <aside class="market-panel">

            <div class="market-row">

                <span>Today's Open</span>

                <strong>2,840.20</strong>

            </div>

            <div class="market-row">

                <span>High</span>

                <strong class="positive">2,861.40</strong>

            </div>

            <div class="market-row">

                <span>Low</span>

                <strong class="negative">2,829.60</strong>

            </div>

            <div class="market-row">

                <span>Prev Close</span>

                <strong>2,820.10</strong>

            </div>

            <div class="market-row">

                <span>Volume</span>

                <strong>2.41M</strong>

            </div>

            <div class="market-row">

                <span>Avg Volume</span>

                <strong>3.11M</strong>

            </div>

            <div class="day-range">

                <span>Day Range</span>

                <div class="range-bar">

                    <div class="range-indicator"></div>

                </div>

                <div class="range-values">

                    <span>2,829.60</span>

                    <span>2,861.40</span>

                </div>

            </div>

        </aside>
    </section>
    <div class="drawer-overlay" id="orderDrawerOverlay">

        <partial name="_OrderDrawer" />

    </div>
</div>



@section Scripts {

    <script type="text/javascript"
            src="https://s3.tradingview.com/tv.js">
    </script>

    <script src="~/js/pages/orderDrawer.js" asp-append-version="true"></script>
    <script>

        new TradingView.widget({

            container_id: "tradingview_chart",

            autosize: true,

            symbol: "NSE:RELIANCE",

            interval: "15",

            timezone: "Asia/Kolkata",

            theme: "light",

            style: "1",

            locale: "en",

            toolbar_bg: "#f8fafc",

            enable_publishing: false,

            allow_symbol_change: true,

            withdateranges: true,

            hide_side_toolbar: false,

            hide_top_toolbar: false,

            save_image: false

        });

    </script>

}
