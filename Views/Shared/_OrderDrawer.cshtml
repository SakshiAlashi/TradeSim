<aside class="order-drawer" id="orderDrawer">

    <!-- HEADER -->

    <div class="drawer-header">

        <div class="drawer-header-left">

            <h3 id="orderDrawerTitle" class="drawer-title">
                BUY @Model.Symbol
            </h3>

            <div class="drawer-subtitle">

                <span class="exchange-tag">
                    NSE
                </span>

                <span class="current-price">
                    ₹@Model.LastPrice.ToString("N2")
                </span>

                <span class="price-change @(Model.Change >= 0 ? "positive" : "negative")">

                    @(Model.Change >= 0 ? "+" : "-")@Math.Abs(Model.Change).ToString("N2")
                    (@Math.Abs(Model.ChangePercent).ToString("0.00")%)

                </span>

            </div>

        </div>

        <button id="closeOrderDrawer"
                class="drawer-close">

            ✕

        </button>

    </div>



    <!-- BODY -->

    <div class="drawer-body">

        <!-- PRODUCT -->

        <div class="drawer-section">

            <label class="section-label">

                Product

            </label>

            <div class="segment-toggle">

                <button id="deliveryBtn" class="segment-btn active" data-product="delivery">
                    Delivery
                </button>

                <button id="intradayBtn" class="segment-btn" data-product="intraday">

                    Intraday

                </button>
            </div>

        </div>

            
        <!-- QUANTITY + PRICE -->

        <div class="drawer-section">

            <div class="quantity-price-row">

                <!-- QUANTITY -->

                <div class="quantity-field">

                    <label class="section-label">
                        Quantity
                    </label>

                    <div class="qty-control">

                        <button class="qty-btn"
                                id="qtyMinus"
                                type="button">
                            −
                        </button>

                        <input id="qtyInput"
                               class="qty-input"
                               type="number"
                               value="1"
                               min="1" />

                        <button class="qty-btn"
                                id="qtyPlus"
                                type="button">
                            +
                        </button>

                    </div>

                </div>


                <!-- PRICE -->

                <div class="price-field">

                    <div class="price-label-row">

                        <label class="section-label">
                            Price (₹)
                        </label>

                        <label class="cmp-option">

                            <input type="checkbox"
                                   id="cmpCheckbox" />

                            <span>CMP</span>

                        </label>

                    </div>

                    <input id="priceInput"
                                class="price-input"
                                type="number"
                                value="@Model.LastPrice"
                                step="0.05" />

                </div>

            </div>

        </div>
        <!-- ORDER TYPE -->

        <div class="drawer-section">

            <label class="section-label">
                Order Variety
            </label>

            <div class="order-type-grid">

                <button type="button" class="type-btn active" data-order="regular">
                    Regular
                </button>

                <button type="button" class="type-btn" data-order="sl">
                    SL
                </button>

                <button type="button" class="type-btn" data-order="slm">
                    SL-M
                </button>

                <button type="button" class="type-btn" data-order="amo">
                    AMO
                </button>

                <button type="button" class="type-btn" data-order="gtt">
                    GTT
                </button>
            </div>

        </div>
        <!-- DYNAMIC ORDER VARIANT FIELDS -->

        <div id="orderVariantFields"></div>

        <!-- VALIDITY -->

        <div class="drawer-section">

            <label class="section-label">
                Validity
            </label>

            <div class="execution-options">

                <label class="radio-option">

                    <input type="radio" id="dayValidity" name="validity" value="DAY" checked />

                    <span class="radio-custom"></span>

                    <span>DAY</span>

                </label>

                <label class="radio-option">

                    <input type="radio" id="iocValidity" name="validity" value="IOC" />

                    <span class="radio-custom"></span>

                    <span>IOC</span>

                </label>

            </div>

        </div>
        <!-- ORDER SUMMARY -->

        <div class="order-summary">

            <div class="summary-row">

                <span>Estimated Value</span>

                <strong id="estimatedOrderValue">
                    ₹28,455.00
                </strong>

            </div>

        </div>
        <!-- FOOTER -->

        <div class="drawer-footer">

            <button id="placeOrderBtn" class="place-order-btn">
                BUY NOW
            </button>

        </div>

    </aside>