<aside class="order-drawer" id="orderDrawer">

    <!-- HEADER -->

    <div class="drawer-header">

        <div class="drawer-header-left">

            <h3 class="drawer-title">
                BUY RELIANCE
            </h3>

            <div class="drawer-subtitle">

                <span class="exchange-tag">
                    NSE
                </span>

                <span class="current-price">
                    ₹2,845.50
                </span>

                <span class="price-change positive">
                    +23.45 (0.83%)
                </span>

            </div>

        </div>

        <button id="closeOrderDrawer"
                class="drawer-close">

            ✕

        </button>

    </div>



    <!-- BODY -->

    <div class="drawer-body">

        <!-- PRODUCT -->

        <div class="drawer-section">

            <label class="section-label">

                Product

            </label>

            <div class="segment-toggle">

                <button class="segment-btn active"
                        data-product="delivery">

                    Delivery

                </button>

                <button class="segment-btn"
                        data-product="intraday">

                    Intraday

                </button>

            </div>

        </div>



        <!-- QUANTITY -->

        <div class="drawer-section">

            <label class="section-label">

                Quantity

            </label>

            <div class="quantity-wrapper">

                <div class="qty-control">

                    <button class="qty-btn"
                            id="qtyMinus">

                        −

                    </button>

                    <input id="qtyInput"
                           class="qty-input"
                           type="number"
                           value="10"
                           min="1" />

                    <button class="qty-btn"
                            id="qtyPlus">

                        +

                    </button>

                </div>

                <div class="lot-card">

                    <span>

                        Lot Size

                    </span>

                    <strong>

                        1

                    </strong>

                </div>

            </div>

        </div>



        <!-- EXECUTION -->

        <div class="drawer-section">

            <label class="section-label">

                Execution

            </label>

            <div class="execution-options">

                <label class="radio-option">

                    <input type="radio"
                           name="execution"
                           checked />

                    <span class="radio-custom"></span>

                    <span>

                        Market

                    </span>

                </label>

                <label class="radio-option">

                    <input type="radio"
                           name="execution" />

                    <span class="radio-custom"></span>

                    <span>

                        Limit

                    </span>

                </label>

            </div>

        </div>



        <!-- DYNAMIC PRICE FIELDS -->

        <div id="priceFields">
        </div>



        <!-- ORDER TYPE -->

        <div class="drawer-section">

            <label class="section-label">

                Order Variety

            </label>

            <div class="order-type-grid">

                <button class="type-btn active"
                        data-order="regular">

                    Regular

                </button>

                <button class="type-btn"
                        data-order="sl">

                    SL

                </button>

                <button class="type-btn"
                        data-order="slm">

                    SL-M

                </button>

                <button class="type-btn"
                        data-order="amo">

                    AMO

                </button>

                <button class="type-btn"
                        data-order="gtt">

                    GTT

                </button>

            </div>

        </div>
        <!-- VALIDITY -->

        <div class="drawer-section">

            <label class="section-label">

                Validity

            </label>

            <div class="execution-options">

                <label class="radio-option">

                    <input type="radio"
                           name="validity"
                           checked />

                    <span class="radio-custom"></span>

                    <span>

                        DAY

                    </span>

                </label>

                <label class="radio-option">

                    <input type="radio"
                           name="validity" />

                    <span class="radio-custom"></span>

                    <span>

                        IOC

                    </span>

                </label>

            </div>

        </div>



        <!-- ESTIMATED CHARGES -->

        <div class="drawer-section">

            <label class="section-label">

                Estimated Charges

            </label>

            <div class="charges-card">

                <div class="charge-row">

                    <span>

                        Estimated Value

                    </span>

                    <strong>

                        ₹28,455.00

                    </strong>

                </div>

                <div class="charge-row">

                    <span>

                        Brokerage

                    </span>

                    <strong>

                        ₹0.00

                    </strong>

                </div>

                <div class="charge-row">

                    <span>

                        Taxes & Charges

                    </span>

                    <strong>

                        ₹43.21

                    </strong>

                </div>

                <div class="charge-divider"></div>

                <div class="charge-row total-row">

                    <span>

                        Total Amount

                    </span>

                    <strong>

                        ₹28,498.21

                    </strong>

                </div>

            </div>

        </div>



        <!-- BALANCE -->

        <div class="drawer-section">

            <div class="balance-card">

                <div>

                    <small>

                        Available Balance

                    </small>

                    <h4>

                        ₹1,00,000.00

                    </h4>

                </div>

                <button class="add-funds-btn">

                    Add Funds

                </button>

            </div>

        </div>

    </div>

    <!-- FOOTER -->

    <div class="drawer-footer">

        <button class="place-order-btn">

            <span>

                BUY NOW

            </span>

            <span>

                ₹28,498.21

            </span>

        </button>

    </div>

</aside>