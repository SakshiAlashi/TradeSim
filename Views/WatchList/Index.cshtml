@model TradeSim.ViewModels.WatchlistViewModel

@{
    ViewData["Title"] = "Watchlist";
    ViewData["PageTitle"] = "Watchlist";
    ViewData["PageSubtitle"] = "Track your stocks and favorites";
}

<div class="watchlist-page">

    <!-- ========================================== -->
    <!-- TABS / TOOLBAR -->
    <!-- ========================================== -->

    <div class="watchlist-toolbar">

        <div class="watchlist-tabs">

            <!-- ALL STOCKS -->

            <button type="button"
                    class="watchlist-tab active"
                    data-tab="all-stocks">
                All Stocks
            </button>


            <!-- MY WATCHLIST -->

            <button type="button"
                    class="watchlist-tab"
                    data-tab="watchlist">
                My Watchlist
            </button>


            <!-- FAVORITES -->

            <button type="button"
                    class="watchlist-tab"
                    data-tab="favorites">
                Favorites
            </button>


            <!-- INDICES -->

            <button type="button"
                    class="watchlist-tab"
                    data-tab="indices">
                Indices
            </button>

        </div>
    </div>


    <!-- ========================================== -->
    <!-- ALL STOCKS -->
    <!-- ========================================== -->

    <div id="all-stocks-tab"
         class="watchlist-tab-content active">

        <div class="watchlist-list">

            @foreach (var stock in Model.Stocks
                .Where(x =>
                    x.Symbol != "NIFTY" &&
                    x.Symbol != "BANKNIFTY"))
            {
                <a asp-controller="Stock"
                   asp-action="Details"
                   asp-route-symbol="@stock.Symbol"
                   class="watchlist-row stock-row"
                   data-symbol="@stock.Symbol">

                    <div class="symbol-section">

                        <!-- ADD TO WATCHLIST -->

                        <button type="button"
                                class="add-watchlist-btn"
                                data-instrument-id="@stock.TradableInstrumentId"
                            @(stock.IsInWatchlist ? "disabled" : "")>

                            <i class="bi @(stock.IsInWatchlist ? "bi-check" : "bi-plus")"></i>

                        </button>

                        <span class="symbol">
                            @stock.Symbol
                        </span>

                    </div>

                    <span class="price">
                        ₹@stock.LastPrice.ToString("N2")
                    </span>

                    <span class="change @(stock.Change >= 0
                                                                        ? "positive"
                                                                        : "negative")">

                        @(stock.Change >= 0 ? "▲" : "▼")

                        @Math.Abs(stock.ChangePercent).ToString("0.00")%

                    </span>

                </a>
            }

        </div>

    </div>


    <!-- ========================================== -->
    <!-- MY WATCHLIST -->
    <!-- ========================================== -->

    <div id="watchlist-tab" class="watchlist-tab-content">

        <div id="watchlist-list" class="watchlist-list">

            @foreach (var stock in Model.Stocks
                .Where(x =>
                    x.IsInWatchlist &&
                    x.Symbol != "NIFTY" &&
                    x.Symbol != "BANKNIFTY"))
            {
                <a asp-controller="Stock"
                   asp-action="Details"
                   asp-route-symbol="@stock.Symbol"
                   class="watchlist-row stock-row"
                   data-symbol="@stock.Symbol"
                   data-instrument-id="@stock.TradableInstrumentId">

                    <div class="symbol-section">

                        <button type="button"
                                class="favorite-btn"
                                data-instrument-id="@stock.TradableInstrumentId">

                            <i class="bi @(stock.IsFavorite
                                                            ? "bi-star-fill"
                                                            : "bi-star")"></i>

                        </button>


                        <button type="button"
                                class="remove-watchlist-btn">

                            <i class="bi bi-dash-circle"></i>

                        </button>

                        <span class="symbol">
                            @stock.Symbol
                        </span>

                    </div>

                    <span class="price">
                        ₹@stock.LastPrice.ToString("N2")
                    </span>

                    <span class="change @(stock.Change >= 0
                                                                        ? "positive"
                                                                        : "negative")">

                        @(stock.Change >= 0 ? "▲" : "▼")

                        @Math.Abs(stock.ChangePercent).ToString("0.00")%

                    </span>

                </a>
            }

            @if (!Model.Stocks.Any(x =>
                x.IsInWatchlist &&
                x.Symbol != "NIFTY" &&
                x.Symbol != "BANKNIFTY"))
            {
                <div class="empty-watchlist">

                    <i class="bi bi-eye"></i>

                    <p>Your watchlist is empty.</p>

                    <small>
                        Add stocks from All Stocks to start tracking them.
                    </small>

                </div>
            }

        </div>

    </div>


    @* <!-- ========================================== -->
    <!-- FAVORITES -->
    <!-- ========================================== --> *@

    <div id="favorites-tab"
         class="watchlist-tab-content">

        <div class="watchlist-list">

            @foreach (var stock in Model.Stocks
                .Where(x =>
                    x.IsFavorite &&
                    x.Symbol != "NIFTY" &&
                    x.Symbol != "BANKNIFTY"))
            {
                <a asp-controller="Stock"
                   asp-action="Details"
                   asp-route-symbol="@stock.Symbol"
                   class="watchlist-row stock-row"
                   data-instrument-id="@stock.TradableInstrumentId"
                   data-symbol="@stock.Symbol">

                    <div class="symbol-section">

                        <button type="button"
                                class="favorite-btn"
                                data-instrument-id="@stock.TradableInstrumentId">

                            <i class="bi bi-star-fill"></i>

                        </button>

                        <span class="symbol">
                            @stock.Symbol
                        </span>

                    </div>

                    <span class="price">
                        ₹@stock.LastPrice.ToString("N2")
                    </span>

                    <span class="change @(stock.Change >= 0
                                                                        ? "positive"
                                                                        : "negative")">

                        @(stock.Change >= 0 ? "▲" : "▼")

                        @Math.Abs(stock.ChangePercent).ToString("0.00")%

                    </span>

                </a>
            }

            @if (!Model.Stocks.Any(x =>
                x.IsFavorite &&
                x.Symbol != "NIFTY" &&
                x.Symbol != "BANKNIFTY"))
            {
                <div class="empty-watchlist">

                    <i class="bi bi-star"></i>

                    <p>No favorite stocks yet.</p>

                    <small>
                        Mark stocks in your watchlist as favorites for quick access.
                    </small>

                </div>
            }

        </div>

    </div>


    @* <!-- ========================================== -->
    <!-- INDICES -->
    <!-- ========================================== --> *@

    <div id="indices-tab"
         class="watchlist-tab-content">

        <div class="watchlist-list">

            @if (Model.Indices.Any())
            {
                @foreach (var index in Model.Indices)
                {
                    <a asp-controller="Stock"
                       asp-action="Details"
                       asp-route-symbol="@index.Symbol"
                       class="watchlist-row">

                        <div class="symbol-section">

                            <span class="symbol">
                                @index.Symbol
                            </span>

                        </div>

                        <span class="price">
                            ₹@index.LastPrice.ToString("N2")
                        </span>

                        <span class="change @(index.Change >= 0
                                                            ? "positive"
                                                            : "negative")">

                            @(index.Change >= 0 ? "▲" : "▼")

                            @Math.Abs(index.ChangePercent).ToString("0.00")%

                        </span>

                    </a>
                }
            }
            else
            {
                <div class="empty-watchlist">
                    No market indices available.
                </div>
            }

        </div>

    </div>

</div>
@section Scripts {
    <script src="~/js/pages/watchlist.js" asp-append-version="true"></script>
}